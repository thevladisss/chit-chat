{
  "name": "file-exchange",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=development nodemon --exec ts-node ./src/server.ts",
    "start:prod": "node dist/server.js",
    "debug": "cross-env NODE_ENV=development NODE_OPTIONS=--inspect nodemon --exec ts-node ./src/server.ts",
    "format": "prettier --write **/*.{js,ts}",
    "test": "npm run test:unit --coverage=false",
    "test:unit": "jest",
    "test:integration": "jest",
    "test:watch": "jest --watch",
    "db:drop": "ts-node scripts/db-drop.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "debug": "~2.6.9",
    "dotenv-flow": "^4.1.0",
    "express": "~4.16.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "mongoose": "^8.16.1",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.1",
    "net-ping": "^1.2.4",
    "nodemon": "^3.1.9",
    "ping": "^0.4.4",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.12",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
